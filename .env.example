# Thesis — environment configuration
# Copy to .env.local for local development. Never commit real values.
# When both keys below are absent the app runs in demo mode: sample reports only, no live research.

# Parallel Task API key (research provider). https://platform.parallel.ai
PARALLEL_API_KEY=

# Anthropic API key (report synthesis). https://console.anthropic.com
ANTHROPIC_API_KEY=

# Optional overrides
# Parallel processor used for each depth. Defaults: quick=core, deep=pro.
# Published list prices (per successful run, docs.parallel.ai pricing, read 2026-11-05): core $0.025, pro $0.10, ultra $0.30.
THESIS_PARALLEL_PROCESSOR_QUICK=core
THESIS_PARALLEL_PROCESSOR_DEEP=pro

# Synthesis model and effort. Defaults: claude-opus-5-5, medium.
THESIS_SYNTHESIS_MODEL=claude-opus-5-5
THESIS_SYNTHESIS_EFFORT=medium

# Upper bound on evidence characters sent to the synthesis model (default 36000).
THESIS_MAX_EVIDENCE_CHARS=36000

# Research submissions allowed per network address per minute (default 6).
THESIS_RATE_LIMIT_PER_MINUTE=6
